[Unit]
Description=ALERTRACK Anti-Poaching Edge System
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=always
RestartSec=10
User=alertreck
WorkingDirectory=/home/alertreck/alertreck
Environment="PATH=/home/alertreck/alertreck/venv/bin"
# Run as a module (-m) from the project root so package-relative imports resolve.
ExecStart=/home/alertreck/alertreck/venv/bin/python -m alertrack.main

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=alertrack

# Security
NoNewPrivileges=true
PrivateTmp=true

# Restart policy
RuntimeMaxSec=infinity

[Install]
WantedBy=multi-user.target
